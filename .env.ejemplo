# Copiá este archivo como .env para probar en tu computadora.
# En Render estos mismos valores se cargan en Environment, no en un archivo.
# .env NUNCA se sube a GitHub (está en .gitignore).

# Cliente OAuth de Google (paso 3 de la guía)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Lo genera `npm run token`
GOOGLE_REFRESH_TOKEN=

# Cualquier texto largo al azar; firma las sesiones
SESSION_SECRET=

# Lo genera `npm run clave`. Todo en una sola línea.
USUARIOS=[{"usuario":"rrhh","nombre":"RRHH","sal":"...","hash":"..."}]
